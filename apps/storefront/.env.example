# The GraphQL endpoint the storefront talks to. Required.
#
# A Vercel preview talking to the local Docker API needs an ngrok HTTPS URL
# here (then redeploy) — see docs/vercel-local-api-ngrok.md.
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:3000/graphql"

# Fallback ISO-4217 code used only before a shop has been resolved (the very
# first paint of a route). Every screen that has the shop reads `shop.currency`
# instead — this is never used to price anything that came back from the API.
NEXT_PUBLIC_FALLBACK_CURRENCY="SAR"

# The marketplace's own public origin — the apex, where the shop directory
# lives. Every absolute URL that is NOT a shop's resolves against it: robots.txt,
# the marketplace sitemap, and the "browse all shops" links a shop subdomain has
# to make absolute. Set it to the same value as the vendor dashboard's
# NEXT_PUBLIC_STOREFRONT_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3003"

# The apex that shop subdomains hang off, e.g. "zaydak.com". Setting it turns on
# host-based tenancy: `acme.zaydak.com` then serves Acme's storefront directly,
# with no shop segment in the path, and every canonical URL, OpenGraph tag and
# sitemap entry names that address instead of `zaydak.com/acme`.
#
# LEAVE IT UNSET and nothing changes: every request falls through to the
# path-based routing this app has always used, and `zaydak.com/acme` stays the
# one address a shop has. Both addresses keep working once it is set, so turning
# it on breaks no existing link.
#
# Hostname only — no scheme, no port, no trailing dot. It must match the domain
# whose wildcard DNS (`*.<apex>`) points at this deployment, and the back-end's
# CORS_ORIGINS must carry `https://*.<apex>` or every shop subdomain's requests
# are refused by the browser.
#
# In development it defaults to `localhost`, so `demo.localhost:3003` resolves
# the "demo" shop with no configuration at all — browsers send every *.localhost
# label to the loopback address without a hosts-file entry. That default is used
# for READING a host only; absolute URLs are emitted only when this is set
# explicitly, so an unconfigured deployment never advertises a *.localhost
# address.
# NEXT_PUBLIC_ROOT_DOMAIN="zaydak.com"

# Shared secret that lets the back-end purge a shop from this app's cache.
# Must equal the back-end's STOREFRONT_REVALIDATE_SECRET.
#
# A shop's name, logo, slogan and brand colours are read server-side and cached
# for an hour (`shop:<slug>`). With this set, /api/revalidate-shop accepts a
# signed ping from updateShop and drops that entry, so a vendor's change is live
# on the next request instead of up to sixty minutes later.
#
# NOT public -- no NEXT_PUBLIC_ prefix, and it must never gain one: it is read
# in a route handler and inlining it into the client bundle would publish it.
#
# Unset is a supported configuration: the route answers 404 and the hour-long
# TTL is the only mechanism, which is what this app did before the route
# existed. Refusing is deliberate -- an open cache-purge URL is a free way to
# make every request miss and hit the API.
REVALIDATE_SECRET=""

# ─── Sentry ──────────────────────────────────────────────────────────────────
# All five stay empty until a dedicated storefront project exists. The SDK
# no-ops without a DSN; there is no hardcoded fallback.
# Use a storefront project, not the vendor dashboard's DSN.
#
# NEXT_PUBLIC_SENTRY_DSN is the public client DSN (browser bundle).
# SENTRY_DSN is the same value for Node/edge if you prefer not to expose it
# as NEXT_PUBLIC_*. Source maps need SENTRY_ORG, SENTRY_PROJECT, and
# SENTRY_AUTH_TOKEN at `next build` (token never ships to the browser; leave
# it off local machines). The ingest tunnel is /monitoring.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
