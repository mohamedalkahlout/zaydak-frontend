{
  "out": "./src/bones",
  "breakpoints": [375, 768, 1280, 1536],
  "wait": 2000,
  "color": "#f6f6f7",
  "darkColor": "#262626",
  "animate": "pulse",
  "resolveEnvVars": true,
  "auth": {
    "cookies": [
      {
        "name": "access_token",
        "value": "env[BONEYARD_ACCESS_TOKEN]",
        "domain": "localhost",
        "path": "/"
      },
      {
        "name": "refresh_token",
        "value": "env[BONEYARD_REFRESH_TOKEN]",
        "domain": "localhost",
        "path": "/"
      }
    ]
  },
  "skeletons": {
    "admin-kpi-total-revenue": { "route": "/analytics", "wait": 5000 },
    "admin-kpi-todays-revenue": { "route": "/analytics", "wait": 5000 },
    "admin-kpi-total-orders": { "route": "/analytics", "wait": 5000 },
    "admin-kpi-total-refunds": { "route": "/analytics", "wait": 5000 },
    "admin-kpi-total-shops": { "route": "/analytics", "wait": 5000 },
    "admin-kpi-total-vendors": { "route": "/analytics", "wait": 5000 },
    "admin-kpi-new-customers": { "route": "/analytics", "wait": 5000 },
    "admin-revenue-by-month": { "route": "/analytics", "wait": 5000 },
    "admin-orders-by-status": { "route": "/analytics", "wait": 5000 },
    "admin-provider-cost": { "route": "/analytics", "wait": 5000 },
    "admin-top-shops-cost": { "route": "/analytics", "wait": 5000 },
    "admin-top-products": { "route": "/analytics", "wait": 5000 }
  }
}
