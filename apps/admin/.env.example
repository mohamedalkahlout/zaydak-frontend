# The GraphQL endpoint the admin console talks to. Required.
# Unlike the vendor dashboard, the admin console never sends an X-SHOP header —
# it operates at platform level and relies on the caller's role/permissions.
#
# A Vercel preview talking to the local Docker API needs an ngrok HTTPS URL
# here (then redeploy) — see docs/vercel-local-api-ngrok.md.
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:3000/graphql"
