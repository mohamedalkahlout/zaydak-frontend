# ─── Back-end API ────────────────────────────────────────────────────────────
# The GraphQL endpoint the dashboard talks to (Bearer token + X-SHOP header are
# attached by the Apollo links). Required.
#
# Local default is the Docker/host API. A Vercel preview talking to that same
# API needs an ngrok HTTPS URL here (then redeploy) — see
# docs/vercel-local-api-ngrok.md. Do not point Production at a tunnel.
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:3000/graphql"

# ---- Storefront -------------------------------------------------------------
# Where "View" links out to (the customer-facing shop). The dashboard only ever
# builds URLs against it; it never calls it.
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3003"

# The apex that shop subdomains hang off, e.g. "zaydak.com". Must match the
# storefront's NEXT_PUBLIC_ROOT_DOMAIN exactly.
#
# It changes what a shop handle MEANS, which is why this dashboard needs it at
# all: with an apex set, Settings > Domains previews the address as
# `<handle>.<apex>`; without one it previews `<storefront-host>/<handle>`. Only
# the preview depends on it — the handle itself is the same string either way —
# but a preview that names an address which does not resolve is worse than none.
#
# Leave it unset when the storefront is path-scoped (the default).
# NEXT_PUBLIC_ROOT_DOMAIN="zaydak.com"

# ─── Social sign-in (Google / Apple) ───────────────────────────────────────────
# Public OAuth client IDs. Leave unset to hide the buttons. Back-end must list
# the same ids in GOOGLE_CLIENT_IDS / APPLE_CLIENT_IDS.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="123456789-abc.apps.googleusercontent.com"
# NEXT_PUBLIC_APPLE_CLIENT_ID="com.zaydak.vendor"

# ─── Sentry ──────────────────────────────────────────────────────────────────
# All five stay empty until a dedicated vendor project exists. The SDK
# no-ops without a DSN; there is no hardcoded fallback.
#
# NEXT_PUBLIC_SENTRY_DSN is the public client DSN (browser bundle).
# SENTRY_DSN is the same value for Node/edge if you prefer not to expose it
# as NEXT_PUBLIC_*. Source maps need SENTRY_ORG, SENTRY_PROJECT, and
# SENTRY_AUTH_TOKEN at `next build` (token never ships to the browser; leave
# it off local machines). The ingest tunnel is /monitoring.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
