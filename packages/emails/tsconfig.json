{
  "compilerOptions": {
    "composite": false,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "strictNullChecks": true,
    "resolveJsonModule": true
  },
  "include": ["emails/**/*", "src/**/*"],
  "exclude": ["node_modules", ".react-email", "dist", "out"]
}
